generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  permissions Json?
  users       User[]

  @@index([name])
}

model User {
  id                      String                     @id @default(uuid())
  name                    String
  phone                   String                     @unique
  email                   String?                    @unique
  passwordHash            String
  passwordResetRequired   Boolean                    @default(false)
  passwordChangedAt       DateTime?
  roleId                  String
  status                  String                     @default("ACTIVE")
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  cart                    Cart?
  billingInvoices         PlatformInvoice[]
  manualPayments          ManualPaymentRecord[]
  couponUsages            CouponUsage[]
  notifications           Notification[]
  notificationPref        NotificationPreference?
  orders                  Order[]
  returnRequests          ReturnRequest[]
  reviews                 Review[]
  whatsAppRequests        WhatsAppOrderRequest[]
  runner                  Runner?
  shops                   Shop[]
  supportTickets          SupportTicket[]
  subscriptions           Subscription[]
  passwordResetChallenges PasswordResetChallenge[]
  runnerPreferences       CustomerRunnerPreference[] @relation("CustomerRunnerPreferences")
  approvedPhase1Runners   Runner[]                   @relation("RunnerPhase1ApprovedBy")
  verifiedRepostingGroups RunnerRepostingGroup[]     @relation("RunnerRepostingGroupVerifiedBy")
  reviewedShopLinks       RunnerSubmittedShopLink[]  @relation("RunnerSubmittedShopLinkReviewedBy")
  role                    Role                       @relation(fields: [roleId], references: [id])
  wishlist                Wishlist?

  @@index([phone])
  @@index([email])
  @@index([status])
}

model PasswordResetChallenge {
  id         String    @id @default(uuid())
  userId     String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@index([consumedAt])
}

model Shop {
  id                    String                      @id @default(uuid())
  name                  String
  description           String?
  phone                 String
  address               String?
  ownerId               String
  status                String                      @default("ACTIVE")
  procurementCity       String                      @default("DURBAN")
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  batches               Batch[]
  products              Product[]
  billingInvoices       PlatformInvoice[]
  runnerListings        RunnerListing[]
  runnerAssignments     RunnerShopLink[]
  whatsappImports       WhatsAppImport[]
  captureCheckpoints    WhatsAppCaptureCheckpoint[]
  whatsappGroupMappings WhatsAppGroupMapping[]
  shopRepostLogs        ShopWhatsAppRepostLog[]
  subscriptions         Subscription[]
  owner                 User                        @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([status])
}

model Product {
  id                  String                     @id @default(uuid())
  shopId              String
  name                String
  description         String?
  basePrice           Float
  stockQty            Int                        @default(0)
  images              Json?
  category            String?
  status              String                     @default("ACTIVE")
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  sourceRefreshedAt   DateTime?
  cartItems           CartItem[]
  reservations        InventoryReservation[]
  orderItems          OrderItem[]
  pickLists           PickList[]
  shop                Shop                       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  variants            ProductVariant[]
  reviews             Review[]
  listings            RunnerListing[]
  listingSuppressions RunnerListingSuppression[]
  wishlistItems       WishlistItem[]
  whatsappImports     WhatsAppImport[]
  imageFingerprints   ProductImageFingerprint[]

  @@index([shopId])
  @@index([category])
  @@index([status])
}

model ProductImageFingerprint {
  id             String   @id @default(uuid())
  productId      String
  imageUrl       String
  imageIndex     Int      @default(0)
  sha256         String?
  perceptualHash String?
  mimetype       String?
  width          Int?
  height         Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, imageUrl])
  @@index([productId])
  @@index([sha256])
  @@index([perceptualHash])
  @@index([updatedAt])
}

model ProductDuplicateReviewDismissal {
  id             String   @id @default(uuid())
  shopId         String
  leftProductId  String
  rightProductId String
  reviewedById   String?
  reason         String   @default("KEEP_SEPARATE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([shopId, leftProductId, rightProductId])
  @@index([shopId])
}

model WhatsAppGroupMapping {
  id                 String                  @id @default(uuid())
  shopId             String
  groupId            String                  @unique
  sourceGroup        String
  participants       Int?
  status             String                  @default("ACTIVE")
  groupRole          String                  @default("SOURCE")
  isPrimarySource    Boolean                 @default(false)
  captureEnabled     Boolean                 @default(true)
  postingEnabled     Boolean                 @default(false)
  captureLimitPerRun Int                     @default(100)
  listingLimitPerRun Int                     @default(20)
  lastCaptureAt      DateTime?
  lastPostAt         DateTime?
  archivedAt         DateTime?
  inviteLink         String?
  notes              String?
  createdById        String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  shop               Shop                    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopRepostLogs     ShopWhatsAppRepostLog[]

  @@index([shopId])
  @@index([status])
  @@index([groupRole])
  @@index([isPrimarySource])
  @@index([captureEnabled])
  @@index([postingEnabled])
  @@index([archivedAt])
  @@index([sourceGroup])
}

model ShopWhatsAppRepostLog {
  id                   String               @id @default(uuid())
  shopId               String
  sourceMappingId      String?
  destinationMappingId String
  sourceGroupId        String
  sourceGroupName      String?
  destinationGroupId   String
  destinationGroupName String?
  sourceMessageId      String
  status               String               @default("POSTED")
  error                String?
  retryCount           Int                  @default(0)
  postedAt             DateTime?
  lastAttemptAt        DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  shop                 Shop                 @relation(fields: [shopId], references: [id], onDelete: Cascade)
  destinationMapping   WhatsAppGroupMapping @relation(fields: [destinationMappingId], references: [id], onDelete: Cascade)

  @@unique([destinationMappingId, sourceMessageId])
  @@index([shopId])
  @@index([sourceGroupId])
  @@index([destinationGroupId])
  @@index([status])
  @@index([postedAt])
}

model WhatsAppDiscoveredGroup {
  id                          String                          @id @default(uuid())
  groupId                     String                          @unique
  name                        String
  creatorId                   String?
  creatorPhone                String?
  participants                Int                             @default(0)
  profileImageUrl             String?
  importedShopId              String?
  groupPurpose                String                          @default("UNCLASSIFIED")
  importedRunnerAdvertisingAt DateTime?
  archivedAt                  DateTime?
  lastSeenAt                  DateTime                        @default(now())
  createdAt                   DateTime                        @default(now())
  updatedAt                   DateTime                        @updatedAt
  bridgePresence              WhatsAppBridgeGroupPresence[]
  members                     WhatsAppDiscoveredGroupMember[]
  runnerRepostingGroups       RunnerRepostingGroup[]

  @@index([name])
  @@index([creatorPhone])
  @@index([importedShopId])
  @@index([groupPurpose])
  @@index([archivedAt])
  @@index([lastSeenAt])
}

model WhatsAppDiscoveredGroupMember {
  id                String                  @id @default(uuid())
  discoveredGroupId String
  groupId           String
  phone             String
  status            String                  @default("ACTIVE")
  firstSeenAt       DateTime                @default(now())
  lastSeenAt        DateTime                @default(now())
  archivedAt        DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  discoveredGroup   WhatsAppDiscoveredGroup @relation(fields: [discoveredGroupId], references: [id], onDelete: Cascade)

  @@unique([groupId, phone])
  @@index([discoveredGroupId])
  @@index([phone])
  @@index([status])
  @@index([lastSeenAt])
}

model CustomerGroupConflict {
  id             String    @id @default(uuid())
  customerPhone  String
  city           String
  status         String    @default("OPEN")
  runnerIds      Json
  groups         Json
  chosenRunnerId String?
  resolvedById   String?
  resolvedAt     DateTime?
  resolutionNote String?
  firstSeenAt    DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([customerPhone, city])
  @@index([status])
  @@index([city])
  @@index([customerPhone])
  @@index([chosenRunnerId])
}

model WhatsAppDiscoveredChannel {
  id              String                 @id @default(uuid())
  bridgeAccountId String?
  channelId       String                 @unique
  name            String
  description     String?
  isReadOnly      Boolean                @default(false)
  unreadCount     Int                    @default(0)
  subscriberCount Int?
  inviteLink      String?
  lastActivityAt  DateTime?
  archivedAt      DateTime?
  lastSeenAt      DateTime               @default(now())
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  bridgeAccount   WhatsAppBridgeAccount? @relation(fields: [bridgeAccountId], references: [id], onDelete: Cascade)

  @@index([bridgeAccountId])
  @@index([name])
  @@index([archivedAt])
  @@index([lastSeenAt])
}

model WhatsAppBridgeGroupPresence {
  id                String                  @id @default(uuid())
  bridgeAccountId   String
  discoveredGroupId String
  groupId           String
  name              String
  creatorId         String?
  creatorPhone      String?
  participants      Int                     @default(0)
  profileImageUrl   String?
  isAvailable       Boolean                 @default(true)
  archivedAt        DateTime?
  firstSeenAt       DateTime                @default(now())
  lastSeenAt        DateTime                @default(now())
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  bridgeAccount     WhatsAppBridgeAccount   @relation(fields: [bridgeAccountId], references: [id], onDelete: Cascade)
  discoveredGroup   WhatsAppDiscoveredGroup @relation(fields: [discoveredGroupId], references: [id], onDelete: Cascade)

  @@unique([bridgeAccountId, groupId])
  @@index([bridgeAccountId])
  @@index([discoveredGroupId])
  @@index([groupId])
  @@index([isAvailable])
  @@index([archivedAt])
  @@index([lastSeenAt])
}

model WhatsAppImport {
  id                String    @id @default(uuid())
  shopId            String
  productId         String?
  sourceGroup       String?
  senderPhone       String?
  messageId         String?
  caption           String
  mediaUrls         Json?
  parsedDraft       Json?
  status            String    @default("PENDING")
  error             String?
  receivedAt        DateTime  @default(now())
  importedAt        DateTime?
  resolutionOutcome String?
  matchedImportId   String?
  matchedProductId  String?
  matchConfidence   Float?
  matchAgeDays      Float?
  matchReason       String?
  resolvedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  shop              Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product           Product?  @relation(fields: [productId], references: [id])

  @@unique([shopId, messageId])
  @@index([shopId])
  @@index([status])
  @@index([receivedAt])
  @@index([matchedProductId])
  @@index([resolutionOutcome])
}

model WhatsAppCaptureCheckpoint {
  id                         String    @id @default(uuid())
  shopId                     String
  groupId                    String
  sourceGroup                String?
  lastFullyCapturedMessageId String?
  lastFullyCapturedAt        DateTime?
  lastScanStartedAt          DateTime?
  lastScanCompletedAt        DateTime?
  lastScanStatus             String    @default("NEVER_RUN")
  lastError                  String?
  messagesScanned            Int       @default(0)
  productsCaptured           Int       @default(0)
  productsSkipped            Int       @default(0)
  productsFailed             Int       @default(0)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  shop                       Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, groupId])
  @@index([shopId])
  @@index([lastFullyCapturedAt])
  @@index([lastScanStatus])
}

model Review {
  id         String   @id @default(uuid())
  productId  String
  customerId String
  orderId    String?
  rating     Int
  title      String?
  comment    String?
  verified   Boolean  @default(true)
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order      Order?   @relation(fields: [orderId], references: [id])
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([customerId])
  @@index([rating])
}

model Runner {
  id                               String                     @id @default(uuid())
  userId                           String                     @unique
  publicCode                       String?                    @unique
  rating                           Float?                     @default(0)
  totalOrders                      Int                        @default(0)
  totalEarnings                    Float                      @default(0)
  status                           String                     @default("INACTIVE")
  vehicleType                      String?
  createdAt                        DateTime                   @default(now())
  updatedAt                        DateTime                   @updatedAt
  autoPostEnabled                  Boolean                    @default(false)
  autoPostIntervalMinutes          Int                        @default(30)
  maxPostsPerRun                   Int                        @default(20)
  repostPriceMode                  String                     @default("ORIGINAL")
  repostOrderDetailsEnabled        Boolean                    @default(true)
  repostFeePercentageEnabled       Boolean                    @default(true)
  lastAutoPostAt                   DateTime?
  trialStatus                      String                     @default("TRIAL_PENDING_SETUP")
  trialStartsAt                    DateTime?
  trialEndsAt                      DateTime?
  subscriptionStatus               String                     @default("PENDING_SUBSCRIPTION")
  repostingStatus                  String                     @default("NOT_STARTED")
  approvedAt                       DateTime?
  approvedById                     String?
  phase1Setup                      Json?
  whatsappOrderIntakeEnabled       Boolean                    @default(false)
  whatsappOrderTemplatesVerifiedAt DateTime?
  whatsappOrderTestedAt            DateTime?
  refundMode                       String                     @default("MANUAL_REFUND_ONLY")
  shippingMode                     String                     @default("MANUAL_HANDOVER")
  supervisionMode                  String                     @default("SUPERVISED")
  phase2ReadinessNotes             String?
  phase2ReadinessBlockers          Json?
  phase2LastReviewedAt             DateTime?
  phone                            String?
  serviceArea                      String?
  vehicleNumber                    String?
  whatsappGroup                    String?
  bridgeAccountId                  String?
  approvedBy                       User?                      @relation("RunnerPhase1ApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  bridgeAccount                    WhatsAppBridgeAccount?     @relation(fields: [bridgeAccountId], references: [id], onDelete: SetNull)
  orderRequests                    WhatsAppOrderRequest[]
  orders                           Order[]
  billingInvoices                  PlatformInvoice[]
  platformBillingEvents            PlatformBillingEvent[]
  repostLogs                       WhatsAppRepostLog[]
  stampedMediaLogs                 WhatsAppStampedMediaLog[]
  user                             User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  listings                         RunnerListing[]
  listingSuppressions              RunnerListingSuppression[]
  shopAssignments                  RunnerShopLink[]
  subscriptions                    Subscription[]
  transactions                     RunnerTransaction[]
  wallet                           RunnerWallet?
  serviceCities                    RunnerServiceCity[]
  preferredByCustomers             CustomerRunnerPreference[]
  repostingGroups                  RunnerRepostingGroup[]
  submittedShopLinks               RunnerSubmittedShopLink[]
  botSessions                      BotSession[]

  @@index([userId])
  @@index([status])
  @@index([bridgeAccountId])
  @@index([trialStatus])
  @@index([subscriptionStatus])
  @@index([repostingStatus])
  @@index([approvedById])
  @@index([whatsappOrderIntakeEnabled])
  @@index([refundMode])
  @@index([shippingMode])
  @@index([supervisionMode])
}

model RunnerRepostingGroup {
  id                     String                   @id @default(uuid())
  runnerId               String
  whatsappGroupId        String?
  discoveredGroupId      String?
  bridgeAccountId        String?
  groupName              String
  inviteLink             String?
  isTestGroup            Boolean                  @default(false)
  status                 String                   @default("GROUP_LINK_RECEIVED")
  botJoinStatus          String                   @default("GROUP_LINK_RECEIVED")
  botAdminStatus         String                   @default("ADMIN_STATUS_PENDING")
  runnerConfirmedAdminAt DateTime?
  adminVerifiedAt        DateTime?
  adminVerifiedById      String?
  notes                  String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  runner                 Runner                   @relation(fields: [runnerId], references: [id], onDelete: Cascade)
  adminVerifiedBy        User?                    @relation("RunnerRepostingGroupVerifiedBy", fields: [adminVerifiedById], references: [id], onDelete: SetNull)
  bridgeAccount          WhatsAppBridgeAccount?   @relation(fields: [bridgeAccountId], references: [id], onDelete: SetNull)
  discoveredGroup        WhatsAppDiscoveredGroup? @relation(fields: [discoveredGroupId], references: [id], onDelete: SetNull)

  @@index([runnerId])
  @@index([status])
  @@index([botJoinStatus])
  @@index([botAdminStatus])
  @@index([adminVerifiedById])
  @@index([bridgeAccountId])
  @@index([discoveredGroupId])
}

model RunnerSubmittedShopLink {
  id           String    @id @default(uuid())
  runnerId     String
  inviteLink   String
  status       String    @default("PENDING_REVIEW")
  notes        String?
  reviewedAt   DateTime?
  reviewedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  runner       Runner    @relation(fields: [runnerId], references: [id], onDelete: Cascade)
  reviewedBy   User?     @relation("RunnerSubmittedShopLinkReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([runnerId, inviteLink])
  @@index([runnerId])
  @@index([status])
  @@index([reviewedById])
}

model BotSession {
  id             String   @id @default(uuid())
  runnerId       String?
  whatsappNumber String
  currentStep    String   @default("WELCOME")
  lastQuestion   String?
  lastResponse   String?
  sessionStatus  String   @default("ACTIVE")
  context        Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  runner         Runner?  @relation(fields: [runnerId], references: [id], onDelete: SetNull)

  @@index([runnerId])
  @@index([whatsappNumber])
  @@index([sessionStatus])
  @@index([currentStep])
}

model RunnerServiceCity {
  id        String   @id @default(uuid())
  runnerId  String
  city      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  runner    Runner   @relation(fields: [runnerId], references: [id], onDelete: Cascade)

  @@unique([runnerId, city])
  @@index([city, active])
}

model CustomerRunnerPreference {
  id          String    @id @default(uuid())
  customerId  String
  city        String
  runnerPhone String
  runnerId    String?
  status      String    @default("PENDING_MATCH")
  matchedAt   DateTime?
  replacedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  customer    User      @relation("CustomerRunnerPreferences", fields: [customerId], references: [id], onDelete: Cascade)
  runner      Runner?   @relation(fields: [runnerId], references: [id], onDelete: SetNull)

  @@unique([customerId, city])
  @@index([runnerPhone])
  @@index([runnerId])
  @@index([status])
}

model WhatsAppBridgeAccount {
  id                    String                        @id @default(uuid())
  name                  String
  phone                 String?                       @unique
  expectedPhone         String?
  verifiedPhone         String?
  phoneVerifiedAt       DateTime?
  verificationStatus    String                        @default("UNVERIFIED")
  mismatchReason        String?
  mode                  String                        @default("CAPTURE_AND_POST")
  sessionName           String?                       @unique
  workerKey             String?                       @unique
  status                String                        @default("INACTIVE")
  capacityRunners       Int                           @default(8)
  maxPostsPerRun        Int                           @default(20)
  runtimeSettings       Json?
  notes                 String?
  archivedAt            DateTime?
  lastSeenAt            DateTime?
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt
  discoveredGroups      WhatsAppBridgeGroupPresence[]
  discoveredChannels    WhatsAppDiscoveredChannel[]
  runnerRepostingGroups RunnerRepostingGroup[]
  runners               Runner[]
  outboundMessages      WhatsAppOutboundMessage[]

  @@index([status])
  @@index([mode])
  @@index([verificationStatus])
  @@index([archivedAt])
  @@index([lastSeenAt])
}

model WhatsAppOutboundMessage {
  id              String                @id @default(uuid())
  bridgeAccountId String
  recipientPhone  String
  messageType     String                @default("TEXT")
  messageText     String
  mediaUrl        String?
  filename        String?
  mimeType        String?
  status          String                @default("PENDING")
  attempts        Int                   @default(0)
  lastError       String?
  claimedAt       DateTime?
  expiresAt       DateTime
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  bridgeAccount   WhatsAppBridgeAccount @relation(fields: [bridgeAccountId], references: [id], onDelete: Cascade)

  @@index([bridgeAccountId, status, createdAt])
  @@index([expiresAt])
}

model AdminAuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  summary     String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([action])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
}

model RunnerShopLink {
  id                    String    @id @default(uuid())
  runnerId              String
  shopId                String
  status                String    @default("PENDING")
  joinedAt              DateTime  @default(now())
  approvedAt            DateTime?
  notes                 String?
  selectedForTest       Boolean   @default(false)
  selectedForLive       Boolean   @default(false)
  autoListEnabled       Boolean   @default(true)
  autoPostEnabled       Boolean   @default(false)
  markupPercent         Float     @default(0.3)
  destinationGroup      String?
  maxPostsPerRun        Int       @default(20)
  maximumListingAgeDays Int       @default(14)
  minPrice              Float?
  maxPrice              Float?
  categoryFilter        String?
  requireMedia          Boolean   @default(true)
  runner                Runner    @relation(fields: [runnerId], references: [id], onDelete: Cascade)
  shop                  Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([runnerId, shopId])
  @@index([runnerId])
  @@index([shopId])
  @@index([status])
  @@index([selectedForTest])
  @@index([selectedForLive])
  @@index([autoListEnabled])
  @@index([autoPostEnabled])
}

model RunnerListing {
  id                     String                    @id @default(uuid())
  runnerId               String
  productId              String
  markup                 Float                     @default(0)
  runnerPrice            Float
  status                 String                    @default("ACTIVE")
  autoPostApproved       Boolean                   @default(false)
  orderCode              String?                   @unique
  lastPostedAt           DateTime?
  postCount              Int                       @default(0)
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  startedAt              DateTime?
  pausedAt               DateTime?
  stoppedAt              DateTime?
  scheduledStartAt       DateTime?
  repostFrequencyMinutes Int                       @default(60)
  maximumListingAgeDays  Int                       @default(14)
  expiryDate             DateTime?
  activeGroupIds         Json?
  shopId                 String?
  cartItems              CartItem[]
  orderItems             OrderItem[]
  product                Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderRequests          WhatsAppOrderRequest[]
  repostLogs             WhatsAppRepostLog[]
  stampedMediaLogs       WhatsAppStampedMediaLog[]
  runner                 Runner                    @relation(fields: [runnerId], references: [id], onDelete: Cascade)
  shop                   Shop?                     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([runnerId, productId])
  @@index([runnerId])
  @@index([productId])
  @@index([orderCode])
  @@index([shopId])
}

model RunnerListingSuppression {
  id        String   @id @default(uuid())
  runnerId  String
  productId String
  shopId    String?
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  runner    Runner   @relation(fields: [runnerId], references: [id], onDelete: Cascade)

  @@unique([runnerId, productId])
  @@index([runnerId])
  @@index([productId])
  @@index([shopId])
}

model RunnerSkippedItem {
  id                   String    @id @default(uuid())
  runnerId             String
  productId            String
  listingId            String?
  shopId               String?
  orderCode            String?
  sourceMessageId      String?
  source               String    @default("RUNNER_SKIP_COMMAND")
  reason               String?
  productName          String?
  productImageUrls     Json?
  productImageHashes   Json?
  imageLabels          Json?
  matchedSkippedItemId String?
  matchScore           Float?
  status               String    @default("ACTIVE")
  skippedAt            DateTime  @default(now())
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([runnerId, productId])
  @@index([runnerId])
  @@index([productId])
