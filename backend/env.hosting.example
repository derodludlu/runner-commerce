# Backend hosting/tunnel values for the local PM2 API.
# Keep the local WhatsApp bridge and monitor running while adding these.

PORT=3001
NODE_ENV=production

# Public frontend domains allowed to call this backend with credentials.
# Prefer exact origins. Add preview domains only when you intentionally test them.
FRONTEND_URLS=https://your-vercel-app.vercel.app,http://localhost:3000,http://localhost:3002
CORS_ORIGINS=https://your-vercel-app.vercel.app,http://localhost:3000,http://localhost:3002
FRONTEND_URL=https://your-vercel-app.vercel.app
NEXT_PUBLIC_FRONTEND_URL=https://your-vercel-app.vercel.app

# Cloudflare tunnel will expose this local backend URL.
PUBLIC_BACKEND_URL=https://api.your-domain.example
BACKEND_URL=http://localhost:3001
