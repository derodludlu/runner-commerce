{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2021",
    "rootDir": "./src",
    "outDir": "./dist",

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "sourceMap": true,
    "incremental": true,

    "strict": true,
    "skipLibCheck": true
  },

  "exclude": [
    "node_modules",
    "dist",
    "scripts",
    "test",
    "prisma",
    "prisma.config.ts",
    "prisma/migrations"
  ]
}
